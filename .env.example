# Copia este archivo como .env y rellena los valores. .env no se versiona.
# Correo institucional de la Universidad de Sevilla (usuario y clave UVUS).
ESIEM_SMTP_HOST=mail.us.es
ESIEM_SMTP_PORT=587
ESIEM_SMTP_TLS=true
ESIEM_SMTP_USER=usuario@us.es
ESIEM_SMTP_PASSWORD=
ESIEM_FROM_EMAIL=ESIEM <usuario@us.es>
# false = enviar desde Outlook y registrar en el CRM (cuando el SMTP no permite enviar).
ESIEM_EMAIL_AUTOMATIC=true

# Base de datos PostgreSQL (la única soportada).
ESIEM_DB_NAME=esiem
ESIEM_DB_USER=esiem
ESIEM_DB_PASSWORD=
ESIEM_DB_HOST=localhost
ESIEM_DB_PORT=5432
